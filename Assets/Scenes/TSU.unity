    - target: {fileID: 7443337996247761284, guid: 6d304f0c5868c5b4e96b326ca4296029, type: 3}
      propertyPath: m_text
      value: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 4. \xAB\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F
        \u0444\u043E\u0440\u043C\u0443\u043B\u0430 (\u043D\u0435\u043F\u043E\u043B\u043D\u0430\u044F)\xBB\r\n\u041B\u0438\u0447\u043D\u044B\u0439
        \u0434\u043D\u0435\u0432\u043D\u0438\u043A \u0434-\u0440\u0430 \u0425\u0430\u0443\u044D\u0440\u0430.
        \u0411\u0435\u0437 \u0433\u0440\u0438\u0444\u0430. \u0422\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u044B\u0439
        \u043F\u043E\u0447\u0435\u0440\u043A, \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430
        \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u0430.\r\n\u042F \u0441\u043E\u0431\u0440\u0430\u043B
        \u0432\u0441\u0451 \u0432\u043E\u0435\u0434\u0438\u043D\u043E. \u0422\u0440\u0438
        \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430:\r\n\u0422\u0435\u043B\u043E\u043C\u0438\u0440\u0430\u0437\u0430
        \u2014 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E
        \u0442\u0440\u0430\u043D\u0441\u043A\u0440\u0438\u043F\u0442\u0430\u0437\u0443,
        \u043D\u0435 \u0434\u0430\u0432\u0430\u044F \u0432\u0438\u0440\u0443\u0441\u0443
        \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
        \u043D\u0435\u0439\u0440\u043E\u043D\u044B.\r\n\u0425\u0435\u043B\u0430\u0442\u043E\u0440
        \u0436\u0435\u043B\u0435\u0437\u0430 (\u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442
        \u0434\u0435\u0444\u0435\u0440\u043E\u043A\u0441\u0430\u043C\u0438\u043D)
        \u2014 \u043B\u0438\u0448\u0430\u0435\u0442 \u0432\u0438\u0440\u0443\u0441
        \u043A\u0430\u0442\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440\u0430,
        \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u0435\u0442 \u0440\u0435\u043F\u043B\u0438\u043A\u0430\u0446\u0438\u044E
        \u0432 5 \u0440\u0430\u0437.\r\ngRNA-\u043B\u043E\u0432\u0443\u0448\u043A\u0430
        \u043D\u0430 \u0444\u0443\u043B\u043B\u0435\u0440\u0435\u043D\u0435 C\u2086\u2080
        \u2014 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0435\u0442 CRISPR-\u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
        \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
        \u0433\u0435\u043D\u043E\u0432.\r\n\u041D\u043E \u044D\u0442\u043E\u0433\u043E
        \u043C\u0430\u043B\u043E. \u0424\u043E\u0440\u043C\u0443\u043B\u0430 \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430.
        \u041D\u0443\u0436\u0435\u043D \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
        \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u2014 \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0442\u043E\u0440,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442
        \u0432\u0441\u0451 \u0432 \u043E\u0434\u043D\u0443 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u044E
        \u0438 \u043D\u0435 \u0434\u0430\u0441\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0443
        \u043E\u0442\u0442\u043E\u0440\u0433\u043D\u0443\u0442\u044C \u043D\u0430\u043D\u043E\u0447\u0430\u0441\u0442\u0438\u0446\u044B.
        \u042F \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B
        14 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0439. \u041D\u0438
        \u043E\u0434\u043D\u043E \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
        \u0431\u0435\u0437 \u043F\u043E\u0431\u043E\u0447\u043D\u044B\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u043E\u0432.\r\n\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
        \u0438\u0434\u0435\u044F: \u0441\u043F\u0438\u043D\u043D\u043E\u043C\u043E\u0437\u0433\u043E\u0432\u0430\u044F
        \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C \u043D\u0435\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
        \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \u041E\u043D\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
        \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u043D\u0430\u0431\u043E\u0440
        \u0431\u0435\u043B\u043A\u043E\u0432-\u0448\u0430\u043F\u0435\u0440\u043E\u043D\u043E\u0432,
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0445 \xAB\u043E\u0431\u0435\u0440\u043D\u0443\u0442\u044C\xBB
        \u043D\u0430\u043D\u043E\u0447\u0430\u0441\u0442\u0438\u0446\u0443 \u0438
        \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0435\u0451 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0439
        \u0434\u043B\u044F \u0438\u043C\u043C\u0443\u043D\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B.
        \u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430: \u043D\u0443\u0436\u0435\u043D
        \u0434\u043E\u043D\u043E\u0440 \u0441 \u0440\u0435\u0434\u043A\u043E\u0439
        \u043C\u0443\u0442\u0430\u0446\u0438\u0435\u0439 \u0433\u0435\u043D\u0430
        HLA-G (\u0442\u043E\u043B\u0435\u0440\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u044C
        \u043A \u0447\u0443\u0436\u0435\u0440\u043E\u0434\u043D\u044B\u043C \u0431\u0435\u043B\u043A\u0430\u043C).
        \u0422\u0430\u043A\u0438\u0445 \u043B\u044E\u0434\u0435\u0439 0.03% \u043F\u043E\u043F\u0443\u043B\u044F\u0446\u0438\u0438.\r\n\u041F\u0440\u0438\u043F\u0438\u0441\u043A\u0430
        \u0432\u043D\u0438\u0437\u0443 \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C
        (\u0432\u0438\u0434\u0438\u043C\u043E, \u0421\u0430\u0440\u043A\u0438\u0441\u044F\u043D\u0430):\r\n\xAB\u0425\u0430\u0443\u044D\u0440
        \u043F\u0440\u0430\u0432. \u042F \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B
        \u043D\u0430 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0435 \u043A\u043B\u0435\u0442\u043E\u043A.
        \u0421\u043F\u0438\u043D\u043D\u043E\u043C\u043E\u0437\u0433\u043E\u0432\u0430\u044F
        \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u044C \u0441 HLA-G \u043C\u0443\u0442\u0430\u0446\u0438\u0435\u0439
        \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u0415\u0441\u043B\u0438
        \u043A\u0442\u043E-\u0442\u043E \u044D\u0442\u043E \u0447\u0438\u0442\u0430\u0435\u0442
        \u2014 \u043F\u0440\u043E\u0432\u0435\u0440\u044C \u0441\u0435\u0431\u044F.
        \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u044B \u0434\u043E\u043D\u043E\u0440.
        \u0421\u0434\u0430\u0439 \u0430\u043D\u0430\u043B\u0438\u0437 \u043A\u0440\u043E\u0432\u0438
        \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
        \u0422\u0413\u0423.\xBB\r\n"
      objectReference: {fileID: 0}

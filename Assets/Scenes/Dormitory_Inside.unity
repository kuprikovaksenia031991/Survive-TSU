  doorOpenSound: {fileID: 8300000, guid: 44b63b0db16ce624b97e45ebde0a0971, type: 3}
  doorCloseSound: {fileID: 8300000, guid: bc37ad25465405a428a26ff0facd9a7b, type: 3}
  playerBedPosition: {fileID: 1900241735}
  neighbourBedPosition: {fileID: 1063802748}
  neighbourRunTarget: {fileID: 755975869}
  neighbourDeathPosition: {fileID: 1569802118}
  zombiePosition: {fileID: 1641408007}
  sickNeighbourBedPosition: {fileID: 1488538008}
  dialoguePanel: {fileID: 257062700}
  neighbourLines:
  - "- \u042D\u0439, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435!"
  - "- \u0414\u0430... *\u0448\u043C\u044B\u0433 \u043D\u043E\u0441\u043E\u043C*...
    \u042F... \u042F \u043F\u043E\u043C\u043E\u0433\u0430\u043B \u0443\u0447\u0451\u043D\u043E\u043C\u0443
    \u0438\u0437 \u043D\u0430\u0448\u0435\u0433\u043E \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u0430...
    \u042D\u0442\u043E \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438,
    \u043D\u043E... \u042F \u0434\u0443\u043C\u0430\u044E \u0443\u0436\u0435 \u043D\u0435
    \u0432\u0430\u0436\u043D\u043E... *\u0448\u043C\u044B\u0433 \u043D\u043E\u0441\u043E\u043C*...
    \u041C\u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0435\u0434\u043E\u043B\u0433\u043E,
    \u0434\u0443\u043C\u0430\u044E, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0447\u0430\u0441\u043E\u0432... \u041A\u0430\u043A \u0442\u044B \u043C\u043E\u0433
    \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C, \u0442\u0430\u043C \u0435\u0441\u0442\u044C
    \u0437\u043E\u043C\u0431\u0438, \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445
    \u0443\u043A\u0443\u0441\u0438\u043B \u043C\u0435\u043D\u044F \u0438 \u044F \u0441\u043A\u043E\u0440\u043E
    \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0443\u0441\u044C... *\u0434\u0432\u043E\u0439\u043D\u043E\u0439
    \u0448\u043C\u044B\u0433*... \u0414\u043B\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0430 \u043D\u0443\u0436\u043D\u044B
    \u0437\u0430\u043F\u0438\u0441\u0438.. \u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u044B...
    \u0422\u0430\u043C \u0435\u0441\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F...
    *\u0448\u043C\u044B\u0433\u0430\u0435\u0442* \u041E\u0447\u0435\u043D\u044C \u0432\u0430\u0436\u043D\u0430\u044F
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F... \u041C\u044B..\u0412\u044B..\u0431\u0443\u0434\u0435\u0442\u0435
    \u0441\u043F\u0430\u0441\u0435\u043D\u044B, \u0435\u0441\u043B\u0438 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0438\u0445 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0435\u043C\u0443...
    \u0422\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C \u043F\u043E\u043C\u043E\u0447\u044C?"
  - "- \u0414\u0430, \u044F \u043F\u043E\u043D\u0438\u043C\u0430\u044E, \u0447\u0442\u043E
    \u0442\u044B \u043D\u0430\u043F\u0443\u0433\u0430\u043D... \u041D\u043E \u044D\u0442\u043E
    \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u043C \u0432\u0441\u0435\u043C \u0438
    \u0442\u0435\u0431\u0435 \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435...
    *\u0448\u043C\u044B\u0433* \u042D\u0442\u043E \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E,
    \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
    \u0438\u0445 \u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442...
    \u0422\u0430\u043C \u0442\u0435\u0431\u044F \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
    \u0443\u0447\u0451\u043D\u044B\u0439, \u043E\u043D \u0436\u0434\u0435\u0442 \u043C\u0435\u043D\u044F,
    \u043D\u043E \u0442\u044B... \u0421\u043A\u0430\u0436\u0438, \u0447\u0442\u043E
    \u044F... \u0427\u0442\u043E \u044F... \u041D\u0443... *\u0448\u043C\u044B\u0433* "
  - "-\u0421\u043F\u0430\u0441\u0438\u0431\u043E... \u0412 \u043E\u0431\u0449\u0435\u0436\u0438\u0442\u0438\u0438
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0445\u043E\u0434\u0438\u0442\u044C
    \u043F\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0430\u043C, \u0447\u0442\u043E\u0431\u044B
    \u043D\u0430\u0439\u0442\u0438 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435... *\u0448\u043C\u044B\u0433*
    \u0447\u0435\u043C \u043E\u0442\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F
    \u0438\u043B\u0438 \u043B\u0435\u0447\u0438\u0442\u044C\u0441\u044F, \u043D\u0443
    \u0438 \u0442\u0430\u043A, \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C...
    \u0411\u0443\u0434\u044C \u0433\u043E\u0442\u043E\u0432, \u043E\u043D\u0438 \u043C\u0443\u0442\u0438\u0440\u0443\u044E\u0442
    \u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u0441\u0438\u043B\u044C\u043D\u0435\u0435
    \u0438 \u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430\u0439 \u0443\u043A\u0443\u0441\u043E\u0432!...
    \u0412 \u043C\u043E\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043B\u0435\u0436\u0438\u0442

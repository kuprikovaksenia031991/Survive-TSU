  m_Script: {fileID: 11500000, guid: b6abb8a54eea99247ba067f846cee548, type: 3}
  m_Name: Note3
  m_EditorClassIdentifier: 
  itemName: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u21163"
  description: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  icon: {fileID: 0}
  quantity: 1
  isStackable: 1
  noteText: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 3. \xAB\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442
    \u211631: \u041D\u0435\u0439\u0442\u0440\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
    CRISPR-\u0432\u0435\u043A\u0442\u043E\u0440\u0430\xBB\r\n\u0414\u043B\u044F \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
    \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F. \u041E\u0442\u0434\u0435\u043B
    \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u044F\u0440\u043D\u043E\u0439 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438.
    \u0410\u0432\u0442\u043E\u0440: \u0434-\u0440 \u0421\u0430\u0440\u043A\u0438\u0441\u044F\u043D.
    \u0414\u0430\u0442\u0430: [\u0442\u0440\u0435\u043C\u044F \u0434\u043D\u044F\u043C\u0438
    \u043F\u043E\u0437\u0436\u0435]\r\n\u041C\u044B \u0432\u044B\u0434\u0435\u043B\u0438\u043B\u0438
    Cas9-\u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0439 \u0431\u0435\u043B\u043E\u043A,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0438\u0440\u0443\u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
    \u0434\u043B\u044F \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F
    \u0433\u0435\u043D\u0430 FAAH. \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
    \u0447\u0442\u043E \u043E\u043D \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u0435\u043D
    \u0432 \u0449\u0435\u043B\u043E\u0447\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u0435
    (pH > 8.5). \u0411\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E: \u0435\u0441\u043B\u0438
    \u0432\u0432\u0435\u0441\u0442\u0438 \u0432 \u043A\u0440\u043E\u0432\u044C \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0433\u043E
    \u0441\u0438\u043D\u0442\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0433\u0438\u0434\u043E\u0432\u044B\u0439 \u0420\u041D\u041A-\u043B\u043E\u0432\u0443\u0448\u043A\u0443
    (gRNA-trap), \u043E\u043D \u0441\u0432\u044F\u0436\u0435\u0442\u0441\u044F \u0441
    \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u043C \u0446\u0435\u043D\u0442\u0440\u043E\u043C
    Cas9 \u0438 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
    \u0435\u0433\u043E, \u043A\u0430\u043A \u043A\u043B\u044E\u0447, \u0437\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0438\u0439
    \u0432 \u0437\u0430\u043C\u043A\u0435.\r\n\u041F\u0440\u043E\u0431\u043B\u0435\u043C\u0430:
    gRNA-\u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u0431\u044B\u0441\u0442\u0440\u043E
    \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442\u0441\u044F \u0432 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u043C
    \u0441\u043E\u043A\u0435 \u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
    \u043F\u0440\u0438\u043D\u044F\u0442\u0430 \u043F\u0435\u0440\u043E\u0440\u0430\u043B\u044C\u043D\u043E.
    \u041D\u0443\u0436\u0435\u043D \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C
    \u2014 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
    \u0432 \u043A\u0440\u043E\u0432\u044C, \u043C\u0438\u043D\u0443\u044F \u0436\u0435\u043B\u0443\u0434\u043E\u043A.
    \u0421\u0430\u0440\u043A\u0438\u0441\u044F\u043D \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043B
    \u0441 \u0444\u0443\u043B\u043B\u0435\u0440\u0435\u043D\u043E\u043C C\u2086\u2080,
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
    \u0430\u043C\u0438\u043D\u043E\u0433\u0440\u0443\u043F\u043F\u0430\u043C\u0438.
    \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u043E\u0431\u043D\u0430\u0434\u0451\u0436\u0438\u0432\u0430\u0435\u0442:
    \u043E\u0434\u043D\u0430 \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u044F \u043D\u0430\u043D\u043E\u0447\u0430\u0441\u0442\u0438\u0446
    \u0441 gRNA-trap \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430
    \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0432\u0438\u0440\u0443\u0441\u0430
    \u0443 \u043A\u0440\u044B\u0441\u044B \u043D\u0430 42 \u0447\u0430\u0441\u0430.\r\n\u0412\u044B\u0432\u043E\u0434:
    gRNA-\u043B\u043E\u0432\u0443\u0448\u043A\u0430 + \u0444\u0443\u043B\u043B\u0435\u0440\u0435\u043D
    C\u2086\u2080 = \u0441\u043F\u043E\u0441\u043E\u0431 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
    \u0432\u0438\u0440\u0443\u0441\u043D\u044B\u0439 \u0440\u0435\u0434\u0430\u043A\u0442\u043E\u0440
    \u0433\u0435\u043D\u043E\u0432. \u041D\u043E \u043D\u0443\u0436\u0435\u043D \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442 \u0434\u043B\u044F \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438
    \u0444\u043E\u0440\u043C\u0443\u043B\u044B.\r"
  isNote: 1

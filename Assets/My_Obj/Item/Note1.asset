  m_Name: Note1
  m_EditorClassIdentifier: 
  itemName: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 \u21161"
  description: "\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  icon: {fileID: 0}
  quantity: 1
  isStackable: 1
  noteText: "\u0417\u0430\u043F\u0438\u0441\u043A\u0430 1. \xAB\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442
    \u211617: \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0448\u0442\u0430\u043C\u043C\u0430\xBB\r\n\u041A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E.
    \u041E\u0442\u0434\u0435\u043B \u0431\u0438\u043E\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0438\u0438
    \u041D\u0418\u0418 \xAB\u0413\u0435\u043D\u0435\u0442\u0435\u043A\u0441\xBB.
    \u0410\u0432\u0442\u043E\u0440: \u0434-\u0440 \u0425\u0430\u0443\u044D\u0440.
    \u0414\u0430\u0442\u0430: [\u0437\u0430\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u043E]\r\n\u0418\u0441\u043F\u044B\u0442\u0443\u0435\u043C\u044B\u0439
    \u2014 \u043C\u0430\u043A\u0430\u043A\u0430-\u0440\u0435\u0437\u0443\u0441, \u0438\u043D\u044A\u0435\u043A\u0446\u0438\u044F
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0440\u0435\u0442\u0440\u043E\u0432\u0438\u0440\u0443\u0441\u0430 \u043B\u0438\u043D\u0438\u0438
    RV-7X-\u03B1. \u0412\u0438\u0440\u0443\u0441 \u043F\u043E\u043B\u0443\u0447\u0435\u043D
    \u043F\u0443\u0442\u0451\u043C \u0441\u043B\u0438\u044F\u043D\u0438\u044F \u0442\u0440\u0451\u0445
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432: \u0433\u0435\u043D\u0430
    \u0431\u0435\u0448\u0435\u043D\u0441\u0442\u0432\u0430 (rabies L-\u043F\u0440\u043E\u0442\u0435\u0438\u043D),
    \u0431\u0435\u043B\u043A\u0430-\u0448\u0438\u043F\u0430 SARS-CoV-2 \u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430
    CRISPR-Cas9, \u0437\u0430\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u043D\u0430 \u0440\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0433\u0435\u043D\u0430 FAAH (\u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u0430\u043D\u0430\u043D\u0434\u0430\u043C\u0438\u0434\u0430 \u2014 \u0433\u043E\u0440\u043C\u043E\u043D\u0430,
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
    \u0431\u043E\u043B\u044C \u0438 \u0441\u0442\u0440\u0430\u0445).\r\n\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
    \u0427\u0435\u0440\u0435\u0437 8 \u0447\u0430\u0441\u043E\u0432 \u0443 \u043F\u0440\u0438\u043C\u0430\u0442\u0430
    \u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u0435
    \u0432\u0441\u043F\u044B\u0448\u043A\u0438 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0438,
    \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u0435\u043C\u044B\u0435
    \u0433\u0438\u043F\u0435\u0440\u0442\u0440\u043E\u0444\u0438\u0435\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u0438 (\u043C\u044B\u0448\u0446\u044B \u0432\u044B\u0440\u043E\u0441\u043B\u0438
    \u043D\u0430 40% \u0437\u0430 \u0441\u0443\u0442\u043A\u0438). \u0411\u043E\u043B\u0435\u0432\u043E\u0439
    \u043F\u043E\u0440\u043E\u0433 \u0441\u043D\u0438\u0436\u0435\u043D \u0434\u043E
    \u043D\u0443\u043B\u044F \u2014 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
    \u043B\u043E\u043C\u0430\u043B\u043E \u043A\u043E\u0441\u0442\u0438 \u043E \u043F\u0440\u0443\u0442\u044C\u044F
    \u043A\u043B\u0435\u0442\u043A\u0438, \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044F.
    \u0421\u0430\u043C\u043E\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0435:
    \u0432\u0438\u0440\u0443\u0441 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u043B
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439
    \u0442\u0440\u0430\u043D\u0441\u043A\u0440\u0438\u043F\u0442\u0430\u0437\u044B
    \u0432 \u043D\u0435\u0439\u0440\u043E\u043D\u0430\u0445 \u0433\u0438\u043F\u043F\u043E\u043A\u0430\u043C\u043F\u0430
    \u2014 \u043E\u043D \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
    \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F. \u041C\u0430\u043A\u0430\u043A\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0430 \u0443\u0437\u043D\u0430\u0432\u0430\u0442\u044C
    \u0441\u043E\u0440\u043E\u0434\u0438\u0447\u0435\u0439. \u0410\u0442\u0430\u043A\u0443\u0435\u0442
    \u0432\u0441\u0451, \u0447\u0442\u043E \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F.\r\n\u0412\u044B\u0432\u043E\u0434:
    \u0428\u0442\u0430\u043C\u043C \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D
    \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C \u043B\u044E\u0431\u043E\u0435
    \u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0435\u0435
    \u0432 \u0431\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043D\u0443\u044E \u043C\u0430\u0448\u0438\u043D\u0443
    \u0434\u043B\u044F \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u0437\u0430
    24 \u0447\u0430\u0441\u0430. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0441\u0440\u043E\u0447\u043D\u0430\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430
    \u0438\u043D\u0433\u0438\u0431\u0438\u0442\u043E\u0440\u0430. \u0425\u0430\u0443\u044D\u0440
    \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u0442\u0435\u043B\u043E\u043C\u0438\u0440\u0430\u0437\u0443 \u043A\u0430\u043A
    \u043A\u043B\u044E\u0447 \u043A \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0435
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0442\u0440\u0430\u043D\u0441\u043A\u0440\u0438\u043F\u0442\u0430\u0437\u044B.\r\r"
  isNote: 1
